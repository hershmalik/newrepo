# ===== Required =====
# Get a key at https://the-odds-api.com (free tier: 500 credits/mo; player props
# cost ~5-10 credits per event fetch, so the $30/mo tier is recommended in-season)
ODDS_API_KEY=

# ===== Push alerts to your phone (strongly recommended for live mode) =====
# 1. Install the free "ntfy" app (iOS/Android)
# 2. In the app, subscribe to a topic with a hard-to-guess name, e.g. hersh-nfl-x8k2q
# 3. Put that same topic name here. That's it - no account needed.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# ===== Odds filters (american odds, no + sign) =====
TARGET_ODDS=10000
SINGLE_MIN_ODDS=2000
SINGLE_MAX_ODDS=40000
LEG_MIN_ODDS=200
LEG_MAX_ODDS=2500
PARLAY_MIN_ODDS=5000
PARLAY_MAX_ODDS=30000
MAX_PARLAY_LEGS=3

# Minimum methodology score for a single-leg pick to be surfaced (see METHODOLOGY.md)
MIN_SCORE=30

# ===== Odds API usage controls =====
# Only fetch props for games starting within this many days (keeps credit usage down)
DAYS_AHEAD=7
# Comma-separated bookmaker keys to restrict to (empty = all US books)
# e.g. draftkings,fanduel,betmgm,caesars
BOOKMAKERS=
# Set to 1 to also pull alternate yardage props (player_reception_yds_alternate etc.)
# Costs more credits but finds "backup WR 100+ yds" style longshots.
ALT_MARKETS=0

# ===== Live mode =====
LIVE_POLL_SECONDS=25
SCOREBOARD_POLL_SECONDS=60

# ===== Dashboard =====
PORT=3000
